def solve_ns(Qfix_charge, dn):
    """
    Solve for ns using the same ns_zero_func as bulk_SRH.surfaceLifetime().
    Returns ns_solved (cm^-3).

    Qfix_charge: C/cm^2 (note sign; your convention uses negative for negative fixed charge)
    dn: cm^-3
    """
    params_ns_zero = (Qfix_charge, T, Ndop_emitter, Ndop_bulk, dop_type_emitter, dop_type_bulk, dn)

    # Search over ns to find a good initial guess
    ns_search_range = np.logspace(16, 20, 8000)
    fzero_values = ns_zero_func(ns_search_range, *params_ns_zero)
    fzero_abs = np.abs(fzero_values)
    ns_guess = lookup(fzero_abs, fzero_abs.min(), ns_search_range)

    # fsolve
    try:
        ns_solved = fsolve(ns_zero_func, ns_guess, args=params_ns_zero, xtol=1e-10, maxfev=2000)[0]
        if not np.isfinite(ns_solved) or ns_solved <= 0:
            return np.nan
        return float(ns_solved)
    except Exception:
        return np.nan


def build_Dit_tot(E_array, params):
    """
    Build total Dit(E) = valence edge + conduction edge + midgap gaussian
    using your Dig_func calls (same as simulate_uv script).
    """
    Dit_valence = Dig_func(E_array, Ev, params["Dit0_v"], params["Ev_trap_sigma"])
    Dit_conduction = Dig_func(E_array, Ec, params["Dit0_c"], params["Ec_trap_sigma"])
    Dit_midgap = Dig_func(E_array, params["E0_g"], params["Dit0_g"], params["sigma_g"])
    return Dit_valence + Dit_conduction + Dit_midgap


def calc_J0s_curve(params, E_array, sigma_n, sigma_p, ni_b):
    """
    Compute J0s(dn) by:
      - solving ns for each dn
      - calling J0sv2_func to obtain J0s (A/cm^2)
    Returns: J0s_array (A/cm^2), ns_array (cm^-3)
    """
    Dit_tot = build_Dit_tot(E_array, params)

    # Convert Qfix number density (cm^-2) to charge density (C/cm^2), with negative sign as in your scripts
    Qfix_charge = -params["Qfix"] * elementary_charge

    J0s_list = []
    ns_list = []

    for dn in dn_array:
        ns = solve_ns(Qfix_charge, dn)
        ns_list.append(ns)

        if not np.isfinite(ns):
            J0s_list.append(np.nan)
            continue

        # X and params for J0sv2_func match your bulk_SRH implementation
        X_j0s = (ns, T, Ndop_emitter, Ndop_bulk, dop_type_emitter, dop_type_bulk, dn, 0)
        params_j0s = (Dit_tot, sigma_n, sigma_p)

        try:
            J0s, Uint, ps, ns_in, Phi_s, Sn0, Sp0, J0s_err = J0sv2_func(X_j0s, *params_j0s)
            # J0s should already be A/cm^2
            J0s_list.append(J0s if np.isfinite(J0s) and J0s > 0 else np.nan)
        except Exception:
            J0s_list.append(np.nan)

    return np.array(J0s_list, dtype=float), np.array(ns_list, dtype=float)


def summarize_J0(label, J0s_arr):
    lo, hi = J0_WINDOW
    mask = (dn_array >= lo) & (dn_array <= hi) & np.isfinite(J0s_arr) & (J0s_arr > 0)

    if np.any(mask):
        med = np.median(J0s_arr[mask])
        mean = np.mean(J0s_arr[mask])
        print(f"[{label}] J0s median ({lo:.1e}–{hi:.1e} cm^-3): {med:.3e} A/cm^2")
        print(f"[{label}] J0s mean   ({lo:.1e}–{hi:.1e} cm^-3): {mean:.3e} A/cm^2")
        return med, mean
    else:
        print(f"[{label}] No valid J0s points in window {lo:.1e}–{hi:.1e}.")
        return np.nan, np.nan
